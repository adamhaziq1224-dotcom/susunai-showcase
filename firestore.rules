rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isNumber(val) { return val is int || val is float; }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "adamhaziq1224@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidUserBase(data) {
      return data.keys().size() <= 30 &&
             data.energy_type is string &&
             data.onboardingCompleted is bool &&
             data.preferences is string &&
             isNumber(data.createdAt) &&
             isNumber(data.updatedAt);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserBase(incoming()) && (incoming().get('role', 'Student') == 'Student' || request.auth.token.email == 'adamhaziq1224@gmail.com');
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && isValidUserBase(incoming()) && incoming().createdAt == existing().createdAt && incoming().get('role', 'Student') == existing().get('role', 'Student')) ||
        (isAdmin() && isValidUserBase(incoming()) && incoming().createdAt == existing().createdAt)
      );
    }

    function isValidAdmin(data) {
      return data.keys().size() <= 4 &&
             data.email is string &&
             data.email.size() <= 150 &&
             isNumber(data.createdAt);
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == adminId && isValidAdmin(incoming()) && request.auth.token.email == 'adamhaziq1224@gmail.com');
      allow update, delete: if isAdmin();
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'type', 'duration', 'date', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 12 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.type is string && data.type.size() <= 100 &&
             isNumber(data.duration) && data.duration > 0 && data.duration <= 1440 &&
             data.date is string && data.date.size() > 0 && data.date.size() <= 100 &&
             data.status in ["pending", "completed"] &&
             (data.get('description', '') is string) &&
             isNumber(data.get('reminderMinutes', 0)) &&
             isNumber(data.get('energyImpact', 0)) &&
             isNumber(data.createdAt) &&
             isNumber(data.updatedAt);
    }

    match /users/{userId}/tasks/{taskId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(taskId) &&
                    isValidTask(incoming()) && 
                    incoming().createdAt >= request.time.toMillis() - 604800000 &&
                    incoming().updatedAt >= request.time.toMillis() - 604800000;
      allow update: if isSignedIn() && (
                      (request.auth.uid == userId && isValidTask(incoming()) &&
                       incoming().updatedAt >= request.time.toMillis() - 604800000 &&
                       incoming().createdAt == existing().createdAt) ||
                      (isAdmin() && isValidTask(incoming()) &&
                       incoming().createdAt == existing().createdAt)
                    );
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['action', 'details', 'timestamp']) &&
             data.keys().size() <= 6 &&
             data.action is string && data.action.size() <= 100 &&
             data.details is string && data.details.size() <= 1000 &&
             isNumber(data.timestamp);
    }

    match /users/{userId}/activities/{activityId} {
      allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(activityId) && isValidActivity(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
